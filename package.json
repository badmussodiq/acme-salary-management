{
  "name": "acme-salary-management",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "oxlint --type-aware",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d --wait",
    "test:integration": "pnpm --filter @acme/api test:integration",
    "verify": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:integration",
    "dev:api": "pnpm --filter @acme/contracts build && pnpm --filter @acme/api start:dev",
    "dev:web": "pnpm --filter @acme/contracts build && pnpm --filter @acme/web dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1"
  }
}
