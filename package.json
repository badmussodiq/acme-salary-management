{
  "name": "acme-salary-management",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev:api": "pnpm --filter @acme/api start:dev",
    "dev:web": "pnpm --filter @acme/web dev"
  }
}
